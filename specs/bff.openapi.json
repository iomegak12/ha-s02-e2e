  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "nexus.sid", "description": "HttpOnly, Secure, SameSite=Strict session cookie. Set by POST /api/v1/session/login." },
      "bearerAuth":    { "type": "http",   "scheme": "bearer", "bearerFormat": "JWT", "description": "Alternative for internal/server-side callers. Browser clients should use sessionCookie." }
    },
    "parameters": {
      "IdempotencyKeyHeader": { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string", "format": "uuid" } },
      "IfMatchETag": { "name": "If-Match", "in": "header", "required": false, "schema": { "type": "string" } },
      "IdPathParam": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "requestBodies": {
      "AnyJson": { "description": "Forwarded as-is to the upstream service. See the upstream OpenAPI spec for the exact body schema.", "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }
    },
    "responses": {
      "Proxied200":     { "description": "Successful upstream response, forwarded unchanged. See upstream spec for exact schema.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
      "Proxied2xx":     { "description": "Created/accepted upstream response, forwarded unchanged. See upstream spec for exact schema.", "headers": { "Location": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
      "ProxiedProblem": { "description": "Upstream business error forwarded as `application/problem+json`. See upstream spec for the exact `code` taxonomy.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
      "BadRequest400":  { "description": "Malformed request at the BFF.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/bad-request", "title": "Bad Request", "status": 400, "code": "BAD_REQUEST", "detail": "Request could not be parsed.", "instance": "/api/v1/patients", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } },
      "Unauthorized401":{ "description": "Session cookie missing, expired, or revoked.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/unauthorized", "title": "Unauthorized", "status": 401, "code": "UNAUTHENTICATED", "detail": "Session is not valid.", "instance": "/api/v1/me", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } },
      "Forbidden403":   { "description": "Authenticated but not permitted.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/unauthorized", "title": "Forbidden", "status": 403, "code": "UNAUTHORIZED", "detail": "Admin role required.", "instance": "/api/v1/admins", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } },
      "NotFound404":    { "description": "Upstream resource not found.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/not-found", "title": "Not Found", "status": 404, "code": "NOT_FOUND", "detail": "Resource was not found.", "instance": "/api/v1/patients/0a9f6c81-2c2b-7b21-8f6b-3a1c2d4e5f70", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } },
      "LifecycleConflict409": { "description": "Invalid state transition reported by upstream.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/lifecycle", "title": "Conflict", "status": 409, "code": "LIFECYCLE_INVALID_TRANSITION", "detail": "Invalid state transition.", "instance": "/api/v1/patients/0a9f6c81/activate", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } },
      "Validation422":  { "description": "Validation failed (at BFF or upstream).", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/validation", "title": "Validation failed", "status": 422, "code": "VALIDATION", "detail": "One or more fields are invalid.", "instance": "/api/v1/patients", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01", "errors": [ { "field": "email", "message": "Invalid email format." } ] } } } },
      "RateLimited429": { "description": "Rate limit exceeded at the BFF.", "headers": { "Retry-After": { "schema": { "type": "integer" } } }, "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/rate-limited", "title": "Too Many Requests", "status": 429, "code": "RATE_LIMITED", "detail": "Request rate exceeded.", "instance": "/api/v1/session/login", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } },
      "BadGateway502":  { "description": "Upstream returned an invalid response.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/bad-gateway", "title": "Bad Gateway", "status": 502, "code": "UPSTREAM_BAD_RESPONSE", "detail": "Upstream service returned an unexpected response.", "instance": "/api/v1/patients", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } },
      "ServiceUnavailable503": { "description": "Upstream service is unavailable.", "headers": { "Retry-After": { "schema": { "type": "integer" } } }, "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/dependency-unavailable", "title": "Service Unavailable", "status": 503, "code": "DEPENDENCY_UNAVAILABLE", "detail": "Patients service is temporarily unavailable.", "instance": "/api/v1/patients", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } },
      "GatewayTimeout504": { "description": "Upstream service timed out.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "example": { "type": "https://errors.nexusha.local/gateway-timeout", "title": "Gateway Timeout", "status": 504, "code": "UPSTREAM_TIMEOUT", "detail": "Upstream service did not respond in time.", "instance": "/api/v1/patients", "traceId": "00-aaaabbbbccccddddeeeeffff00001111-2222333344445555-01" } } } }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 Problem Details with Nexus HA extensions.",
        "properties": {
          "type": { "type": "string", "format": "uri" }, "title": { "type": "string" }, "status": { "type": "integer" },
          "detail": { "type": "string" }, "instance": { "type": "string" }, "code": { "type": "string" }, "traceId": { "type": "string" },
          "errors": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "message": { "type": "string" } }, "required": ["field", "message"] } }
        },
        "required": ["type", "title", "status"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 64 },
          "password": { "type": "string", "format": "password", "minLength": 8 }
        },
        "required": ["username", "password"]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "displayName": { "type": "string" },
          "role": { "type": "string", "enum": ["Admin"] },
          "sessionExpiresAtUtc": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "username", "displayName", "role", "sessionExpiresAtUtc"]
      }
    }
  }
}
