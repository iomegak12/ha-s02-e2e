# Copy this file to `.env` (gitignored) and adjust before `docker compose up`.

# SQL Server SA password.
# Requirements: 8+ chars; at least three of upper / lower / digit / symbol.
SQL_SA_PASSWORD=Nexus_DevPass1!

# Grafana admin credentials. Defaults to admin/admin if unset.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Identity Dev-only admin seeder. Created on first boot when Seeder:DevSeedAdminEnabled=true.
# The integration test suite logs in with these credentials.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Nexus_DevPass1!
