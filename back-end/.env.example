# =============================================================================
# Nexus HA — environment configuration template
# =============================================================================
# This file is safe to commit. It documents every variable consumed by
# docker-compose.yml and docker-compose.prod.yml.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with real values — never commit .env
# =============================================================================

# -----------------------------------------------------------------------------
# SQL Server
# -----------------------------------------------------------------------------
# SA password must satisfy SQL Server complexity requirements:
#   - Minimum 8 characters
#   - Mix of uppercase, lowercase, digits, and special characters
SQL_SA_PASSWORD=CHANGE_ME_strong_sqlserver_password_here

# -----------------------------------------------------------------------------
# Dev identity seeder
# Used only in docker-compose.yml (dev). Ignored in docker-compose.prod.yml.
# -----------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password_here

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password_here

# -----------------------------------------------------------------------------
# EF Core auto-migration
# Set to true for dev (runs migrations on container startup).
# Set to false for prod (apply migrations manually before deploying).
# Default if unset: true in docker-compose.yml, false in docker-compose.prod.yml
# -----------------------------------------------------------------------------
PERSISTENCE_AUTO_MIGRATE=true
