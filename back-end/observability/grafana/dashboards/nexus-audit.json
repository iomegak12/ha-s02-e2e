{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Audit entries appended (rate / 1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 1,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nexus_audit_entries_appended_total[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "ops"
        }
      }
    },
    {
      "type": "stat",
      "title": "Idempotency replays (rate / 1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 2,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nexus_audit_idempotency_replays_total[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "stat",
      "title": "Idempotency conflicts (rate / 1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 3,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nexus_audit_idempotency_conflicts_total[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 0.001 }
          ]}
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Entries appended by source service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (sourceService) (rate(nexus_audit_entries_appended_total[1m]))",
          "legendFormat": "{{sourceService}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Entries appended by action",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (action) (rate(nexus_audit_entries_appended_total[1m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request duration p95 — audit service (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"nexus-audit\"}[5m]))) * 1000",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "logs",
      "title": "Audit service logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "id": 7,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{service_name=\"nexus-audit\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["nexus-ha", "audit"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Nexus HA — Audit Service",
  "uid": "nexus-ha-audit",
  "version": 1,
  "weekStart": ""
}
