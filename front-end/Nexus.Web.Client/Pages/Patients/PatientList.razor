                <button @onclick="SaveEditAsync" disabled="@_editSaving"
                        class="flex items-center gap-2 px-4 py-2 bg-primary text-on-primary font-label-bold text-label-bold rounded-lg hover:bg-primary/90 transition-colors disabled:opacity-50">
                    @if (_editSaving)
                    {
