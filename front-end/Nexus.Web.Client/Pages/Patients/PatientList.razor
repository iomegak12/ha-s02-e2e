                        <div class="sm:col-span-2 flex flex-col gap-1">
                            <label class="font-label-bold text-label-bold text-on-surface-variant">Primary Branch</label>
                            <select @bind="_editForm.PrimaryBranchId"
                                    class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary appearance-none">
                                <option value="">— Unchanged —</option>
