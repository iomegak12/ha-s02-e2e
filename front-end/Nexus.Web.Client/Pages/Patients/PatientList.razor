                            <input @bind="_editForm.AddressLine1" type="text"
                                   class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        </div>
                        <div class="sm:col-span-2 flex flex-col gap-1">
                            <label class="font-label-bold text-label-bold text-on-surface-variant">Address Line 2</label>
                            <input @bind="_editForm.AddressLine2" type="text"
                                   class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="font-label-bold text-label-bold text-on-surface-variant">City</label>
                            <input @bind="_editForm.City" type="text"
                                   class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="font-label-bold text-label-bold text-on-surface-variant">State</label>
                            <input @bind="_editForm.State" type="text"
                                   class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="font-label-bold text-label-bold text-on-surface-variant">Postal Code</label>
