@* ════════════════════════════════════════════════════════════════════════════ *@
@*  LIFECYCLE CONFIRM DIALOG                                                    *@
@* ════════════════════════════════════════════════════════════════════════════ *@
@if (_showLifecycleConfirm && _lifecycleTarget is not null)
{
    var isActivate = _lifecycleAction == "activate";
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
        <div class="bg-surface-card rounded-2xl shadow-2xl w-full max-w-md p-6 flex flex-col gap-4">
            <div class="flex items-center gap-3">
                <div class="@(isActivate ? "bg-success/10 text-success" : "bg-error/10 text-error") w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined">@(isActivate ? "check_circle" : "archive")</span>
                </div>
                <h3 class="font-title-base text-title-base text-on-surface">@(isActivate ? "Activate Patient" : "Archive Patient")</h3>
            </div>
            <p class="font-body-base text-body-base text-on-surface-variant">
                Are you sure you want to @_lifecycleAction <span class="font-medium text-on-surface">@_lifecycleTarget.FullName</span>?
                @if (!isActivate) { <text> This will mark the patient as archived.</text> }
            </p>
            @if (_lifecycleError is not null)
            {
                <div class="p-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">@_lifecycleError</div>
            }
            <div class="flex items-center justify-end gap-3 mt-2">
                <button @onclick="CloseLifecycleConfirm" class="px-4 py-2 bg-surface-container-low text-on-surface font-label-bold text-label-bold rounded-lg hover:bg-surface-container transition-colors border border-outline-variant">
                    Cancel
                </button>
                <button @onclick="ConfirmLifecycleAsync" disabled="@_lifecycleSaving"
                        class="@(isActivate ? "bg-success hover:bg-success/90" : "bg-error hover:bg-error/90") flex items-center gap-2 px-4 py-2 text-white font-label-bold text-label-bold rounded-lg transition-colors disabled:opacity-50">
                    @if (_lifecycleSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-[16px]">progress_activity</span>
                    }
                    @(isActivate ? "Activate" : "Archive")
                </button>
            </div>
        </div>
    </div>
}

@* ── Toast ─────────────────────────────────────────────────────────────────── *@
@if (_toast is not null)
{
    <div class="fixed bottom-6 right-6 z-[9999] flex items-center gap-3 px-4 py-3 rounded-xl shadow-lg @(_toast.IsSuccess ? "bg-success text-white" : "bg-error text-white") font-body-base text-body-base transition-all">
        <span class="material-symbols-outlined text-[20px]">@(_toast.IsSuccess ? "check_circle" : "error")</span>
        @_toast.Message
    </div>
}

@code {
    // ── state ─────────────────────────────────────────────────────────────────
    private bool _loading = true;
    private string? _errorMessage;
    private PagedResult<PatientModel>? _pagedResult;

    private int? _activeCount;
    private int? _draftCount;

    private int _currentPage = 1;
    private const int PageSize = 20;

    private string _searchText = "";
    private string _filterStatus = "";
    private string _filterBranchId = "";
    private string _appliedSearch = "";
    private string _appliedStatus = "";
    private string _appliedBranchId = "";

    private List<(string Id, string Name)> _branchOptions = new();

    // ── wizard ────────────────────────────────────────────────────────────────
    private DateTime? _wizardDob;
    private void SyncDob() => _wizardForm.DateOfBirth = _wizardDob?.ToString("yyyy-MM-dd") ?? "";

    private bool _showAddWizard = false;
    private int _wizardStep = 1;
    private PatientCreateRequest _wizardForm = new();
    private string? _wizardError;
    private bool _wizardSaving = false;
    private Dictionary<string, string> _wizardValidationErrors = new();

    // ── edit modal ────────────────────────────────────────────────────────────
    private bool _showEditModal = false;
    private PatientModel? _editTarget;
    private PatientPatchRequest _editForm = new();
    private string? _editError;
    private bool _editSaving = false;

    // ── lifecycle confirm ─────────────────────────────────────────────────────
    private bool _showLifecycleConfirm = false;
    private PatientModel? _lifecycleTarget;
    private string _lifecycleAction = "";
    private string? _lifecycleError;
    private bool _lifecycleSaving = false;

    // ── toast ─────────────────────────────────────────────────────────────────
    private ToastMessage? _toast;
    private System.Threading.Timer? _toastTimer;

    private sealed record ToastMessage(string Message, bool IsSuccess);

    // ── lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadBranchOptions(), LoadStatCounts());
        await LoadPatients();
    }

    private async Task LoadBranchOptions()
    {
        try
        {
            var result = await BranchService.ListAsync(page: 1, size: 200);
            if (result.IsSuccess && result.Data is not null)
                _branchOptions = result.Data.Items.Select(b => (b.Id, b.Name)).ToList();
        }
        catch { /* non-critical */ }
    }

    private async Task LoadStatCounts()
    {
        try
        {
            var activeTask = PatientService.ListAsync(page: 1, size: 1, status: "Active");
            var draftTask  = PatientService.ListAsync(page: 1, size: 1, status: "Draft");
            await Task.WhenAll(activeTask, draftTask);
            var activeResult = await activeTask;
            var draftResult  = await draftTask;
            if (activeResult.IsSuccess) _activeCount = activeResult.Data?.TotalCount;
            if (draftResult.IsSuccess)  _draftCount  = draftResult.Data?.TotalCount;
        }
        catch { /* non-critical */ }
    }

    private async Task LoadPatients()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await PatientService.ListAsync(
            page: _currentPage,
            size: PageSize,
            status: string.IsNullOrWhiteSpace(_appliedStatus) ? null : _appliedStatus,
            branchId: string.IsNullOrWhiteSpace(_appliedBranchId) ? null : _appliedBranchId,
            q: string.IsNullOrWhiteSpace(_appliedSearch) ? null : _appliedSearch);

        if (result.IsSuccess)
            _pagedResult = result.Data;
        else
            _errorMessage = result.Error?.Detail ?? "Failed to load patients.";

        _loading = false;
    }

    private async Task GoToPage(int page)
    {
        _currentPage = page;
        await LoadPatients();
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        _appliedSearch = _searchText;
        _appliedStatus = _filterStatus;
        _appliedBranchId = _filterBranchId;
        await LoadPatients();
    }

    private async Task ClearFilters()
    {
        _searchText = _filterStatus = _filterBranchId = "";
        _appliedSearch = _appliedStatus = _appliedBranchId = "";
        _currentPage = 1;
        await LoadPatients();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyFilters();
    }

    // ── wizard ────────────────────────────────────────────────────────────────
    private void OpenAddWizard()
    {
        _wizardForm = new();
        _wizardDob = null;
        _wizardStep = 1;
        _wizardError = null;
        _wizardValidationErrors = new();
        _wizardSaving = false;
        _showAddWizard = true;
    }

    private void CloseAddWizard() => _showAddWizard = false;

    private void MaybeCloseWizard() => CloseAddWizard();

    private void WizardNext()
    {
        _wizardValidationErrors = ValidateStep(_wizardStep);
        if (_wizardValidationErrors.Count > 0) return;
        if (_wizardStep < 3) _wizardStep++;
    }

    private void WizardBack()
    {
        if (_wizardStep > 1) _wizardStep--;
        _wizardError = null;
    }

    private async Task WizardSubmitAsync(bool saveDraft)
    {
        _wizardValidationErrors = ValidateStep(3);
        if (_wizardValidationErrors.Count > 0) return;

        _wizardSaving = true;
        _wizardError = null;

        var result = await PatientService.CreateAsync(_wizardForm);
        if (result.IsSuccess)
        {
            var patient = result.Data!;
            if (!saveDraft && patient.Status == "Draft")
            {
                // auto-activate
                var activateResult = await PatientService.ActivateAsync(patient.Id);
                if (!activateResult.IsSuccess)
                    _wizardError = activateResult.Error?.Detail ?? "Registration saved as Draft — activation failed.";
            }
            _showAddWizard = false;
            await LoadStatCounts();
            await LoadPatients();
            ShowToast(saveDraft ? "Patient saved as Draft." : "Patient registered successfully.", true);
        }
        else
        {
            _wizardError = result.Error?.Detail ?? "Failed to register patient.";
        }

        _wizardSaving = false;
    }

    private Dictionary<string, string> ValidateStep(int step)
    {
        var errors = new Dictionary<string, string>();
        if (step == 1)
        {
            if (string.IsNullOrWhiteSpace(_wizardForm.FirstName))  errors["FirstName"]  = "First name is required.";
            if (string.IsNullOrWhiteSpace(_wizardForm.LastName))   errors["LastName"]   = "Last name is required.";
            if (string.IsNullOrWhiteSpace(_wizardForm.DateOfBirth)) errors["DateOfBirth"] = "Date of birth is required.";
            if (string.IsNullOrWhiteSpace(_wizardForm.Gender))     errors["Gender"]     = "Gender is required.";
        }
        else if (step == 2)
        {
            if (string.IsNullOrWhiteSpace(_wizardForm.AddressLine1)) errors["AddressLine1"] = "Address is required.";
            if (string.IsNullOrWhiteSpace(_wizardForm.City))         errors["City"]         = "City is required.";
            if (string.IsNullOrWhiteSpace(_wizardForm.State))        errors["State"]        = "State is required.";
            if (string.IsNullOrWhiteSpace(_wizardForm.PostalCode))   errors["PostalCode"]   = "Postal code is required.";
            if (string.IsNullOrWhiteSpace(_wizardForm.Country) || _wizardForm.Country.Length != 2)
                errors["Country"] = "Country must be a 2-letter ISO code.";
            if (string.IsNullOrWhiteSpace(_wizardForm.PrimaryPhone)) errors["PrimaryPhone"] = "Primary phone is required.";
        }
        else if (step == 3)
        {
            if (string.IsNullOrWhiteSpace(_wizardForm.PrimaryBranchId)) errors["PrimaryBranchId"] = "Primary branch is required.";
        }
        return errors;
    }

    private bool HasFieldError(string field) => _wizardValidationErrors.ContainsKey(field);
    private string GetFieldError(string field) => _wizardValidationErrors.TryGetValue(field, out var e) ? e : "";

    // ── edit modal ────────────────────────────────────────────────────────────
    private void OpenEditModal(PatientModel patient)
    {
        _editTarget = patient;
        _editForm = new()
        {
            FirstName     = patient.FirstName,
            LastName      = patient.LastName,
            PrimaryPhone  = patient.PrimaryPhone,
            Email         = patient.Email,
            AddressLine1  = patient.AddressLine1,
            AddressLine2  = patient.AddressLine2,
            City          = patient.City,
            State         = patient.State,
            PostalCode    = patient.PostalCode,
            Country       = patient.Country,
            PrimaryBranchId = patient.PrimaryBranchId
        };
        _editError = null;
        _editSaving = false;
        _showEditModal = true;
    }

    private void CloseEditModal() => _showEditModal = false;

    private async Task SaveEditAsync()
    {
        if (_editTarget is null) return;
        _editSaving = true;
        _editError = null;

        var result = await PatientService.PatchAsync(_editTarget.Id, _editForm);
        if (result.IsSuccess)
        {
            _showEditModal = false;
            await LoadPatients();
            ShowToast("Patient updated successfully.", true);
        }
        else
        {
            _editError = result.Error?.Detail ?? "Failed to update patient.";
        }

        _editSaving = false;
    }

    // ── lifecycle ─────────────────────────────────────────────────────────────
    private void OpenActivateConfirm(PatientModel patient) => OpenLifecycleConfirm(patient, "activate");
    private void OpenArchiveConfirm(PatientModel patient)  => OpenLifecycleConfirm(patient, "archive");

    private void OpenLifecycleConfirm(PatientModel patient, string action)
    {
        _lifecycleTarget = patient;
        _lifecycleAction = action;
        _lifecycleError = null;
        _lifecycleSaving = false;
        _showLifecycleConfirm = true;
    }

    private void CloseLifecycleConfirm() => _showLifecycleConfirm = false;

    private async Task ConfirmLifecycleAsync()
    {
        if (_lifecycleTarget is null) return;
        _lifecycleSaving = true;
        _lifecycleError = null;

        ApiResponse<PatientModel> result = _lifecycleAction == "activate"
            ? await PatientService.ActivateAsync(_lifecycleTarget.Id)
            : await PatientService.ArchiveAsync(_lifecycleTarget.Id);

        if (result.IsSuccess)
        {
            _showLifecycleConfirm = false;
            await LoadStatCounts();
            await LoadPatients();
            ShowToast($"Patient {_lifecycleAction}d successfully.", true);
        }
        else
        {
            _lifecycleError = result.Error?.Detail ?? $"Failed to {_lifecycleAction} patient.";
        }

        _lifecycleSaving = false;
    }

    // ── helpers ───────────────────────────────────────────────────────────────
    private string GetBranchName(string branchId)
    {
        if (string.IsNullOrWhiteSpace(branchId)) return "—";
        var branch = _branchOptions.FirstOrDefault(b => b.Id == branchId);
        return string.IsNullOrEmpty(branch.Name) ? branchId : branch.Name;
    }

    private static readonly string[] AvatarColors =
    [
        "bg-primary", "bg-secondary", "bg-tertiary",
        "bg-[#7B5EA7]", "bg-[#2E7D8B]", "bg-[#A0522D]"
    ];

    private static string GetAvatarClass(PatientModel patient)
    {
        int hash = Math.Abs((patient.FirstName + patient.LastName).GetHashCode());
        return AvatarColors[hash % AvatarColors.Length];
    }

    private void ShowToast(string message, bool success)
    {
        _toastTimer?.Dispose();
        _toast = new ToastMessage(message, success);
        StateHasChanged();
        _toastTimer = new System.Threading.Timer(_ =>
        {
            _toast = null;
            InvokeAsync(StateHasChanged);
        }, null, 3500, System.Threading.Timeout.Infinite);
    }

    public void Dispose() => _toastTimer?.Dispose();
}
