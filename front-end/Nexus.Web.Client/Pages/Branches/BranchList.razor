@page "/branches"
@attribute [Authorize]
@inject IBranchService BranchService
@inject IJSRuntime JS

<PageTitle>Branches Directory — Nexus HA</PageTitle>

@* ── Page Content ─────────────────────────────────────────────────────────── *@
<div class="p-margin-page flex-1 flex flex-col max-w-[1400px] mx-auto w-full">

    @* Header & Toolbar *@
    <div class="mb-stack-lg flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="font-headline-md text-headline-md text-on-surface">Branches Directory</h1>
            <p class="font-body-base text-body-base text-on-surface-variant mt-1">Manage hospital branches and facility status.</p>
        </div>
        <div class="flex w-full sm:w-auto items-center gap-3">
            @* View toggle *@
            <div class="flex items-center bg-surface-container-low border border-outline-variant rounded-lg p-0.5 gap-0.5">
                <button @onclick="() => _viewMode = ViewMode.Grid" title="Grid view"
                        class="@(_viewMode == ViewMode.Grid ? "bg-surface-card shadow-sm text-primary" : "text-on-surface-variant hover:text-on-surface") p-[7px] rounded-md transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px]" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 3.5A.75.75 0 0 1 2.75 7.5h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 8.25Zm0 3.5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Zm0 3.5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                    </svg>
                </button>
                <button @onclick="() => _viewMode = ViewMode.Card" title="Card view"
                        class="@(_viewMode == ViewMode.Card ? "bg-surface-card shadow-sm text-primary" : "text-on-surface-variant hover:text-on-surface") p-[7px] rounded-md transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px]" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4.25 2A2.25 2.25 0 0 0 2 4.25v2.5A2.25 2.25 0 0 0 4.25 9h2.5A2.25 2.25 0 0 0 9 6.75v-2.5A2.25 2.25 0 0 0 6.75 2h-2.5Zm0 9A2.25 2.25 0 0 0 2 13.25v2.5A2.25 2.25 0 0 0 4.25 18h2.5A2.25 2.25 0 0 0 9 15.75v-2.5A2.25 2.25 0 0 0 6.75 11h-2.5Zm9-9A2.25 2.25 0 0 0 11 4.25v2.5A2.25 2.25 0 0 0 13.25 9h2.5A2.25 2.25 0 0 0 18 6.75v-2.5A2.25 2.25 0 0 0 15.75 2h-2.5Zm0 9A2.25 2.25 0 0 0 11 13.25v2.5A2.25 2.25 0 0 0 13.25 18h2.5A2.25 2.25 0 0 0 18 15.75v-2.5A2.25 2.25 0 0 0 15.75 11h-2.5Z" clip-rule="evenodd" />
                    </svg>
                </button>
                <button @onclick="() => _viewMode = ViewMode.Kanban" title="Kanban view"
                        class="@(_viewMode == ViewMode.Kanban ? "bg-surface-card shadow-sm text-primary" : "text-on-surface-variant hover:text-on-surface") p-[7px] rounded-md transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px]" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2A1.5 1.5 0 0 1 7 3.5v13A1.5 1.5 0 0 1 5.5 18h-2A1.5 1.5 0 0 1 2 16.5v-13Zm5.5 0A1.5 1.5 0 0 1 9 2h2a1.5 1.5 0 0 1 1.5 1.5v8A1.5 1.5 0 0 1 11 13H9a1.5 1.5 0 0 1-1.5-1.5v-8ZM15 2a1.5 1.5 0 0 0-1.5 1.5v5A1.5 1.5 0 0 0 15 10h2a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 17 2h-2Z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            <button @onclick="OpenAddModal"
                    class="flex items-center justify-center gap-2 bg-primary text-on-primary font-label-bold text-label-bold h-10 px-4 rounded-lg hover:bg-primary/90 transition-colors shadow-sm w-full sm:w-auto">
                <span class="material-symbols-outlined text-[16px]">add</span>
                Add Branch
            </button>
        </div>
    </div>

    @* ── Filter Card ──────────────────────────────────────────────────── *@
    <div class="bg-surface-card rounded-xl border border-surface-container-high shadow-[0_2px_8px_-2px_rgba(0,0,0,0.05)] mb-stack-lg p-padding-card">
        <div class="flex flex-col lg:flex-row gap-4 items-end">
            @* Search *@
            <div class="w-full lg:w-1/3 flex flex-col gap-1">
                <label class="font-label-bold text-label-bold text-on-surface-variant">Search Branches</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
                    <input @bind="_searchText" @bind:event="oninput" @onkeydown="OnSearchKeyDown"
                           type="text" placeholder="Search by Code or Name..."
                           class="w-full pl-9 pr-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder:text-outline" />
                </div>
            </div>
            @* City Filter *@
            <div class="w-full sm:w-1/2 lg:w-1/4 flex flex-col gap-1">
                <label class="font-label-bold text-label-bold text-on-surface-variant">City</label>
                <input @bind="_filterCity" type="text" placeholder="e.g. Mumbai"
                       class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder:text-outline" />
            </div>
            @* Status Filter *@
            <div class="w-full sm:w-1/2 lg:w-1/4 flex flex-col gap-1">
                <label class="font-label-bold text-label-bold text-on-surface-variant">Status</label>
                <select @bind="_filterStatus"
                        class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors appearance-none">
                    <option value="">All Statuses</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            @* Filter Actions *@
            <div class="w-full lg:w-auto flex gap-2">
                <button @onclick="ApplyFilters"
                        class="h-10 px-4 bg-primary text-on-primary font-label-bold text-label-bold rounded-lg hover:bg-primary/90 transition-colors w-full lg:w-auto flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[16px]">filter_list</span>
                    Filter
                </button>
                <button @onclick="ClearFilters"
                        class="h-10 px-4 border border-outline-variant text-on-surface font-label-bold text-label-bold rounded-lg hover:bg-surface-container-low transition-colors w-full lg:w-auto flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[16px]">close</span>
                    Clear
                </button>
            </div>
        </div>
    </div>

    @* ── Data Table Card ──────────────────────────────────────────────── *@
    <div class="bg-surface-card rounded-xl border border-surface-container-high shadow-[0_2px_8px_-2px_rgba(0,0,0,0.05)] flex-1 flex flex-col overflow-hidden">

        @if (_loading)
        {
            <div class="flex-1 flex items-center justify-center py-20">
                <LoadingSpinner />
            </div>
        }
        else if (_branches is null || _branches.Count == 0)
        {
            <div class="flex-1 flex items-center justify-center py-20">
                <EmptyState Icon="account_tree" Title="No Branches Found"
                            Message="@(_hasActiveFilter ? "No branches match your current filters." : "No branches have been added yet. Click 'Add Branch' to get started.")" />
            </div>
        }
        else
        {
            @* ── Grid view ──────────────────────────────────────────────── *@
            @if (_viewMode == ViewMode.Grid)
            {
                <div class="overflow-x-auto flex-1" style="scrollbar-width:thin;scrollbar-color:#c7c4d8 transparent;">
                    <table class="w-full text-left border-collapse min-w-[640px]">
                        <thead>
                            <tr class="bg-surface-container-lowest border-b border-surface-container-high">
                                <th class="py-3 px-4 font-label-bold text-label-bold text-on-surface-variant whitespace-nowrap">Branch Code</th>
                                <th class="py-3 px-4 font-label-bold text-label-bold text-on-surface-variant whitespace-nowrap">Name</th>
                                <th class="py-3 px-4 font-label-bold text-label-bold text-on-surface-variant whitespace-nowrap">City</th>
                                <th class="py-3 px-4 font-label-bold text-label-bold text-on-surface-variant whitespace-nowrap">Status</th>
                                <th class="py-3 px-4 font-label-bold text-label-bold text-on-surface-variant whitespace-nowrap text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="font-body-base text-body-base text-on-surface divide-y divide-surface-container-low">
                            @foreach (var branch in _branches)
                            {
                                <tr class="hover:bg-surface-container-low/50 transition-colors">
                                    <td class="py-3 px-4 font-code-mono text-code-mono text-primary font-medium">@branch.Code</td>
                                    <td class="py-3 px-4 font-label-bold">@branch.Name</td>
                                    <td class="py-3 px-4 text-on-surface-variant">@branch.City</td>
                                    <td class="py-3 px-4">
                                        @if (branch.IsActive)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-status-active/10 text-status-active border border-status-active/20">Active</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-status-error/10 text-status-error border border-status-error/20">Inactive</span>
                                        }
                                    </td>
                                    <td class="py-3 px-4 text-right">
                                        <button @onclick="() => OpenEditModal(branch)"
                                                class="text-on-surface-variant hover:text-primary p-1 rounded hover:bg-surface-container-high transition-colors"
                                                title="Edit branch">
                                            <span class="material-symbols-outlined">edit</span>
                                        </button>
                                        @if (branch.IsActive)
                                        {
                                            <button @onclick="() => ConfirmDeactivate(branch)"
                                                    class="text-on-surface-variant hover:text-status-error p-1 rounded hover:bg-surface-container-high transition-colors ml-1"
                                                    title="Deactivate branch">
                                                <span class="material-symbols-outlined">block</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => ReactivateBranch(branch)"
                                                    class="text-on-surface-variant hover:text-status-active p-1 rounded hover:bg-surface-container-high transition-colors ml-1"
                                                    title="Reactivate branch">
                                                <span class="material-symbols-outlined">check_circle</span>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* ── Card view ───────────────────────────────────────────────── *@
            else if (_viewMode == ViewMode.Card)
            {
                <div class="p-4 overflow-y-auto flex-1" style="scrollbar-width:thin;scrollbar-color:#c7c4d8 transparent;">
                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
                        @foreach (var branch in _branches)
                        {
                            <div class="bg-surface-bg border border-surface-container-high rounded-xl p-4 flex flex-col gap-3 hover:shadow-md transition-shadow">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <span class="font-code-mono text-[11px] font-semibold text-primary bg-primary/[0.08] px-2 py-0.5 rounded">@branch.Code</span>
                                        <h3 class="font-label-bold text-label-bold text-on-surface mt-2 truncate">@branch.Name</h3>
                                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5 flex items-center gap-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="m9.69 18.933.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 0 0 .281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 1 0 3 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 0 0 2.273 1.765 11.842 11.842 0 0 0 .976.544l.062.029.018.008.006.003ZM10 11.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" clip-rule="evenodd" />
                                            </svg>
                                            @branch.City
                                        </p>
                                    </div>
                                    @if (branch.IsActive)
                                    {
                                        <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-status-active/10 text-status-active border border-status-active/20">Active</span>
                                    }
                                    else
                                    {
                                        <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-status-error/10 text-status-error border border-status-error/20">Inactive</span>
                                    }
                                </div>
                                <div class="flex items-center justify-end gap-1 pt-2 border-t border-surface-container-low">
                                    <button @onclick="() => OpenEditModal(branch)"
                                            class="text-on-surface-variant hover:text-primary p-1.5 rounded hover:bg-surface-container-high transition-colors"
                                            title="Edit branch">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </button>
                                    @if (branch.IsActive)
                                    {
                                        <button @onclick="() => ConfirmDeactivate(branch)"
                                                class="text-on-surface-variant hover:text-status-error p-1.5 rounded hover:bg-surface-container-high transition-colors"
                                                title="Deactivate branch">
                                            <span class="material-symbols-outlined text-[18px]">block</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button @onclick="() => ReactivateBranch(branch)"
                                                class="text-on-surface-variant hover:text-status-active p-1.5 rounded hover:bg-surface-container-high transition-colors"
                                                title="Reactivate branch">
                                            <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ── Kanban view ─────────────────────────────────────────────── *@
            else
            {
                <div class="p-4 overflow-y-auto flex-1 flex gap-4" style="scrollbar-width:thin;scrollbar-color:#c7c4d8 transparent;">
                    @* Active column *@
                    <div class="flex-1 min-w-0 flex flex-col gap-2">
                        <div class="flex items-center gap-2 px-3 py-2 bg-status-active/10 rounded-lg border border-status-active/20 mb-1">
                            <div class="w-2 h-2 rounded-full bg-status-active shrink-0"></div>
                            <span class="font-label-bold text-label-bold text-status-active">Active</span>
                            <span class="ml-auto font-code-mono text-[11px] font-semibold text-status-active bg-status-active/[0.15] px-1.5 py-0.5 rounded-full">@_branches.Count(b => b.IsActive)</span>
                        </div>
                        @if (!_branches.Any(b => b.IsActive))
                        {
                            <div class="flex flex-col items-center justify-center py-10 text-on-surface-variant font-body-sm text-body-sm border-2 border-dashed border-surface-container-high rounded-lg">
                                <span class="material-symbols-outlined text-[32px] mb-2 opacity-40">inbox</span>
                                No active branches
                            </div>
                        }
                        else
                        {
                            @foreach (var branch in _branches.Where(b => b.IsActive))
                            {
                                <div class="bg-surface-bg border border-surface-container-high rounded-lg p-3 hover:shadow-sm hover:border-status-active/30 transition-all">
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="min-w-0">
                                            <span class="font-code-mono text-[11px] font-semibold text-primary bg-primary/[0.08] px-1.5 py-0.5 rounded">@branch.Code</span>
                                            <p class="font-label-bold text-label-bold text-on-surface mt-1.5 truncate">@branch.Name</p>
                                            <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">@branch.City</p>
                                        </div>
                                        <div class="flex gap-0.5 shrink-0">
                                            <button @onclick="() => OpenEditModal(branch)"
                                                    class="text-on-surface-variant hover:text-primary p-1 rounded hover:bg-surface-container-high transition-colors"
                                                    title="Edit">
                                                <span class="material-symbols-outlined text-[16px]">edit</span>
                                            </button>
                                            <button @onclick="() => ConfirmDeactivate(branch)"
                                                    class="text-on-surface-variant hover:text-status-error p-1 rounded hover:bg-surface-container-high transition-colors"
                                                    title="Deactivate">
                                                <span class="material-symbols-outlined text-[16px]">block</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    @* Column divider *@
                    <div class="w-px bg-surface-container-high shrink-0"></div>
                    @* Inactive column *@
                    <div class="flex-1 min-w-0 flex flex-col gap-2">
                        <div class="flex items-center gap-2 px-3 py-2 bg-status-error/10 rounded-lg border border-status-error/20 mb-1">
                            <div class="w-2 h-2 rounded-full bg-status-error shrink-0"></div>
                            <span class="font-label-bold text-label-bold text-status-error">Inactive</span>
                            <span class="ml-auto font-code-mono text-[11px] font-semibold text-status-error bg-status-error/[0.15] px-1.5 py-0.5 rounded-full">@_branches.Count(b => !b.IsActive)</span>
                        </div>
                        @if (!_branches.Any(b => !b.IsActive))
                        {
                            <div class="flex flex-col items-center justify-center py-10 text-on-surface-variant font-body-sm text-body-sm border-2 border-dashed border-surface-container-high rounded-lg">
                                <span class="material-symbols-outlined text-[32px] mb-2 opacity-40">inbox</span>
                                No inactive branches
                            </div>
                        }
                        else
                        {
                            @foreach (var branch in _branches.Where(b => !b.IsActive))
                            {
                                <div class="bg-surface-bg border border-surface-container-high rounded-lg p-3 hover:shadow-sm hover:border-status-error/30 transition-all opacity-80">
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="min-w-0">
                                            <span class="font-code-mono text-[11px] font-semibold text-outline bg-surface-container-low px-1.5 py-0.5 rounded">@branch.Code</span>
                                            <p class="font-label-bold text-label-bold text-on-surface-variant mt-1.5 truncate">@branch.Name</p>
                                            <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">@branch.City</p>
                                        </div>
                                        <div class="flex gap-0.5 shrink-0">
                                            <button @onclick="() => OpenEditModal(branch)"
                                                    class="text-on-surface-variant hover:text-primary p-1 rounded hover:bg-surface-container-high transition-colors"
                                                    title="Edit">
                                                <span class="material-symbols-outlined text-[16px]">edit</span>
                                            </button>
                                            <button @onclick="() => ReactivateBranch(branch)"
                                                    class="text-on-surface-variant hover:text-status-active p-1 rounded hover:bg-surface-container-high transition-colors"
                                                    title="Reactivate">
                                                <span class="material-symbols-outlined text-[16px]">check_circle</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @* Pagination — Grid and Card views only *@
            @if (_viewMode != ViewMode.Kanban)
            {
                <div class="bg-surface-container-lowest px-4 py-3 border-t border-surface-container-high flex items-center justify-between">
                    <div class="font-body-sm text-body-sm text-on-surface-variant">
                        @{
                            var from = (_currentPage - 1) * _pageSize + 1;
                            var to   = Math.Min(_currentPage * _pageSize, _totalCount);
                        }
                        @if (_totalCount == 0)
                        {
                            <span>No entries</span>
                        }
                        else
                        {
                            <span>Showing @from to @to of @_totalCount entries</span>
                        }
                    </div>
                    <div class="flex items-center gap-1">
                        <button @onclick="PrevPage" disabled="@(_currentPage <= 1)"
                                class="p-1 rounded text-on-surface-variant hover:bg-surface-container-low disabled:opacity-40 disabled:cursor-not-allowed">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </button>
                        @for (int p = 1; p <= _totalPages; p++)
                        {
                            var pageNum = p;
                            if (pageNum == _currentPage)
                            {
                                <button class="w-8 h-8 rounded bg-primary text-on-primary font-body-base text-body-base flex items-center justify-center">@pageNum</button>
                            }
                            else if (pageNum <= 2 || pageNum > _totalPages - 2 || Math.Abs(pageNum - _currentPage) <= 1)
                            {
                                <button @onclick="() => GoToPage(pageNum)"
                                        class="w-8 h-8 rounded text-on-surface hover:bg-surface-container-low font-body-base text-body-base flex items-center justify-center">@pageNum</button>
                            }
                            else if (pageNum == 3 && _currentPage > 4)
                            {
                                <span class="px-1 text-on-surface-variant">…</span>
                            }
                            else if (pageNum == _totalPages - 2 && _currentPage < _totalPages - 3)
                            {
                                <span class="px-1 text-on-surface-variant">…</span>
                            }
                        }
                        <button @onclick="NextPage" disabled="@(_currentPage >= _totalPages)"
                                class="p-1 rounded text-on-surface-variant hover:bg-surface-container-low disabled:opacity-40 disabled:cursor-not-allowed">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@* ── Add / Edit Modal ─────────────────────────────────────────────────────── *@
@if (_showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm"
         @onclick="CloseModal">
        <div class="bg-surface-card rounded-xl shadow-2xl w-full max-w-md mx-4 flex flex-col"
             @onclick:stopPropagation="true">
            @* Modal header *@
            <div class="flex items-center justify-between px-6 py-4 border-b border-surface-container-high">
                <h2 class="font-headline-md text-headline-md text-on-surface">
                    @(_editingBranch is null ? "Add Branch" : "Edit Branch")
                </h2>
                <button @onclick="CloseModal"
                        class="text-on-surface-variant hover:text-on-surface p-1 rounded hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            @* Modal body *@
            <div class="px-6 py-5">
                <EditForm Model="_form" OnValidSubmit="SubmitModal">
                    <DataAnnotationsValidator />

                    @if (_modalError is not null)
                    {
                        <div class="mb-4 px-4 py-3 rounded-lg bg-error-container text-on-error-container font-body-base text-body-base">
                            <div class="font-label-bold">@_modalError.Title</div>
                            @if (!string.IsNullOrWhiteSpace(_modalError.Detail))
                            {
                                <div class="mt-0.5">@_modalError.Detail</div>
                            }
                        </div>
                    }

                    @* Code — read-only when editing *@
                    <div class="mb-4">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-1">
                            Branch Code <span class="text-status-error">*</span>
                        </label>
                        @if (_editingBranch is not null)
                        {
                            <div class="w-full px-3 py-2 bg-surface-container-lowest border border-outline-variant rounded-lg font-code-mono text-code-mono text-primary">
                                @_editingBranch.Code
                            </div>
                            <p class="text-body-sm text-on-surface-variant mt-1">Code cannot be changed after creation.</p>
                        }
                        else
                        {
                            <InputText @bind-Value="_form.Code" placeholder="e.g. BLR"
                                       class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder:text-outline uppercase" />
                            <ValidationMessage For="() => _form.Code" class="text-status-error text-body-sm mt-1 block" />
                        }
                    </div>

                    @* Name *@
                    <div class="mb-4">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-1">
                            Branch Name <span class="text-status-error">*</span>
                        </label>
                        <InputText @bind-Value="_form.Name" placeholder="e.g. Bengaluru Main"
                                   class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder:text-outline" />
                        <ValidationMessage For="() => _form.Name" class="text-status-error text-body-sm mt-1 block" />
                    </div>

                    @* City *@
                    <div class="mb-4">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-1">
                            City <span class="text-status-error">*</span>
                        </label>
                        <InputText @bind-Value="_form.City" placeholder="e.g. Bengaluru"
                                   class="w-full px-3 py-2 bg-surface-bg border border-outline-variant rounded-lg font-body-base text-body-base text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder:text-outline" />
                        <ValidationMessage For="() => _form.City" class="text-status-error text-body-sm mt-1 block" />
                    </div>

                    @* Status toggle *@
                    <div class="mb-6 flex items-center gap-3">
                        <label class="font-label-bold text-label-bold text-on-surface-variant">Status</label>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <InputCheckbox @bind-Value="_form.IsActive" class="sr-only peer" />
                            <div class="w-10 h-6 bg-outline-variant rounded-full peer peer-checked:bg-primary peer-focus:ring-2 peer-focus:ring-primary/30 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-4"></div>
                        </label>
                        <span class="font-body-base text-body-base @(_form.IsActive ? "text-status-active" : "text-on-surface-variant")">
                            @(_form.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    @* Footer buttons *@
                    <div class="flex justify-end gap-3 pt-2 border-t border-surface-container-high">
                        <button type="button" @onclick="CloseModal"
                                class="h-10 px-5 border border-outline-variant text-on-surface font-label-bold text-label-bold rounded-lg hover:bg-surface-container-low transition-colors">
                            Cancel
                        </button>
                        <button type="submit" disabled="@_modalSaving"
                                class="h-10 px-5 bg-primary text-on-primary font-label-bold text-label-bold rounded-lg hover:bg-primary/90 transition-colors disabled:opacity-60 flex items-center gap-2">
                            @if (_modalSaving)
                            {
                                <span class="w-4 h-4 border-2 border-on-primary/30 border-t-on-primary rounded-full animate-spin"></span>
                            }
                            @(_editingBranch is null ? "Create Branch" : "Save Changes")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ── Deactivate Confirm Dialog ────────────────────────────────────────────── *@
@if (_confirmDeactivateBranch is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm"
         @onclick="CancelDeactivate">
        <div class="bg-surface-card rounded-xl shadow-2xl w-full max-w-sm mx-4 p-6"
             @onclick:stopPropagation="true">
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-status-error/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-status-error">warning</span>
                </div>
                <div>
                    <h3 class="font-headline-md text-headline-md text-on-surface">Deactivate Branch</h3>
                    <p class="font-body-base text-body-base text-on-surface-variant mt-2">
                        Are you sure you want to deactivate <strong>@_confirmDeactivateBranch.Name</strong>?
                        Existing patient and doctor associations will be preserved.
                    </p>
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button @onclick="CancelDeactivate"
                        class="h-10 px-5 border border-outline-variant text-on-surface font-label-bold text-label-bold rounded-lg hover:bg-surface-container-low transition-colors">
                    Cancel
                </button>
                <button @onclick="ExecuteDeactivate" disabled="@_deactivating"
                        class="h-10 px-5 bg-status-error text-white font-label-bold text-label-bold rounded-lg hover:bg-status-error/90 transition-colors disabled:opacity-60 flex items-center gap-2">
                    @if (_deactivating)
                    {
                        <span class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                    }
                    Deactivate
                </button>
            </div>
        </div>
    </div>
}

@* Toast *@
<Toast @ref="_toast" />

@code {
    // ── View mode ─────────────────────────────────────────────────────────────
    private enum ViewMode { Grid, Card, Kanban }
    private ViewMode _viewMode = ViewMode.Grid;

    // ── State ─────────────────────────────────────────────────────────────────
    private List<BranchModel>? _branches;
    private bool  _loading     = true;
    private int   _currentPage = 1;
    private int   _pageSize    = 20;
    private int   _totalCount  = 0;
    private int   _totalPages  => Math.Max(1, (int)Math.Ceiling((double)_totalCount / _pageSize));

    private string _searchText   = string.Empty;
    private string _filterCity   = string.Empty;
    private string _filterStatus = string.Empty;
    private bool   _hasActiveFilter => !string.IsNullOrWhiteSpace(_searchText) ||
                                       !string.IsNullOrWhiteSpace(_filterCity)  ||
                                       !string.IsNullOrWhiteSpace(_filterStatus);

    // Modal
    private bool              _showModal   = false;
    private bool              _modalSaving = false;
    private ProblemDetails?   _modalError;
    private BranchModel?      _editingBranch;
    private BranchCreateRequest _form = new();

    // Deactivate confirm
    private BranchModel? _confirmDeactivateBranch;
    private bool         _deactivating = false;

    private Toast _toast = default!;

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync() => await LoadAsync();

    // ── Data Loading ──────────────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        bool? isActiveFilter = _filterStatus switch
        {
            "true"  => true,
            "false" => false,
            _       => null
        };
        var city = !string.IsNullOrWhiteSpace(_filterCity) ? _filterCity.Trim() : null;

        var result = await BranchService.ListAsync(_currentPage, _pageSize, city, isActiveFilter);
        if (result.IsSuccess && result.Data is not null)
        {
            var items = result.Data.Items.ToList();
            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var q = _searchText.Trim().ToUpperInvariant();
                items = items.Where(b =>
                    b.Code.ToUpperInvariant().Contains(q) ||
                    b.Name.ToUpperInvariant().Contains(q)).ToList();
            }
            _branches   = items;
            _totalCount = result.Data.TotalCount;
        }
        else
        {
            _branches   = [];
            _totalCount = 0;
            if (result.Error is not null) _toast.Show(result.Error);
        }

        _loading = false;
    }

    // ── Filter Actions ────────────────────────────────────────────────────────
    private async Task ApplyFilters() { _currentPage = 1; await LoadAsync(); }
    private async Task ClearFilters()
    {
        _searchText = string.Empty; _filterCity = string.Empty; _filterStatus = string.Empty;
        _currentPage = 1;
        await LoadAsync();
    }
    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyFilters();
    }

    // ── Pagination ────────────────────────────────────────────────────────────
    private async Task GoToPage(int page) { _currentPage = page; await LoadAsync(); }
    private async Task PrevPage()         { if (_currentPage > 1) { _currentPage--; await LoadAsync(); } }
    private async Task NextPage()         { if (_currentPage < _totalPages) { _currentPage++; await LoadAsync(); } }

    // ── Add / Edit Modal ──────────────────────────────────────────────────────
    private void OpenAddModal()
    {
        _editingBranch = null;
        _form          = new BranchCreateRequest();
        _modalError    = null;
        _showModal     = true;
    }

    private void OpenEditModal(BranchModel branch)
    {
        _editingBranch = branch;
        _form = new BranchCreateRequest
        {
            Code     = branch.Code,
            Name     = branch.Name,
            City     = branch.City,
            IsActive = branch.IsActive
        };
        _modalError = null;
        _showModal  = true;
    }

    private void CloseModal()
    {
        _showModal     = false;
        _modalError    = null;
        _editingBranch = null;
    }

    private async Task SubmitModal()
    {
        _modalSaving = true;
        _modalError  = null;

        ApiResponse<BranchModel> result;
        if (_editingBranch is null)
        {
            result = await BranchService.CreateAsync(_form);
        }
        else
        {
            var patch = new BranchPatchRequest
            {
                Name     = _form.Name     != _editingBranch.Name     ? _form.Name     : null,
                City     = _form.City     != _editingBranch.City     ? _form.City     : null,
                IsActive = _form.IsActive != _editingBranch.IsActive ? _form.IsActive : null
            };
            result = await BranchService.PatchAsync(_editingBranch.Id, patch);
        }

        _modalSaving = false;

        if (result.IsSuccess)
        {
            _showModal = false;
            var verb = _editingBranch is null ? "created" : "updated";
            _toast.ShowSuccess($"Branch {verb}", $"'{result.Data!.Name}' has been {verb} successfully.");
            await LoadAsync();
        }
        else
        {
            _modalError = result.Error;
        }
    }

    // ── Deactivate ────────────────────────────────────────────────────────────
    private void ConfirmDeactivate(BranchModel branch) => _confirmDeactivateBranch = branch;
    private void CancelDeactivate()                    => _confirmDeactivateBranch = null;

    private async Task ExecuteDeactivate()
    {
        if (_confirmDeactivateBranch is null) return;
        _deactivating = true;
        var result = await BranchService.DeactivateAsync(_confirmDeactivateBranch.Id);
        _deactivating = false;

        if (result.IsSuccess)
        {
            var name = _confirmDeactivateBranch.Name;
            _confirmDeactivateBranch = null;
            _toast.ShowSuccess("Branch deactivated", $"'{name}' has been deactivated.");
            await LoadAsync();
        }
        else
        {
            _confirmDeactivateBranch = null;
            if (result.Error is not null) _toast.Show(result.Error);
        }
    }

    private async Task ReactivateBranch(BranchModel branch)
    {
        var patch  = new BranchPatchRequest { IsActive = true };
        var result = await BranchService.PatchAsync(branch.Id, patch);
        if (result.IsSuccess)
        {
            _toast.ShowSuccess("Branch reactivated", $"'{branch.Name}' is now active.");
            await LoadAsync();
        }
        else if (result.Error is not null)
        {
            _toast.Show(result.Error);
        }
    }
}
