@page "/analytics"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Analytics | Nexus HA Clinical Admin</PageTitle>

<div class="p-6 flex-1">
    <div class="mb-6">
        <h1 class="font-display-lg text-display-lg text-on-surface mb-1">Analytics</h1>
        <p class="font-body-base text-body-base text-on-surface-variant">
            Reporting and data insights — coming soon.
        </p>
    </div>

    <div class="flex flex-col items-center justify-center py-24 text-center">
        <span class="material-symbols-outlined text-[64px] text-outline mb-4">bar_chart</span>
        <h2 class="font-headline-md text-headline-md text-on-surface mb-2">Under Construction</h2>
        <p class="font-body-base text-body-base text-on-surface-variant max-w-sm">
            Advanced analytics and reporting features are being built. Check back soon.
        </p>
    </div>
</div>
